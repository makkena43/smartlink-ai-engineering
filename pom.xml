<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>com.smartlink</groupId>
  <artifactId>smartlink</artifactId>
  <version>1.0.0</version>
  <name>SmartLink</name>
  <description>URL shortener built with spec-driven, AI-assisted engineering</description>

  <properties>
    <java.version>21</java.version>
    <springdoc.version>2.8.6</springdoc.version>
    <!-- Coverage floor, not target. See docs/ai-assisted-engineering.md, Article VI. -->
    <jacoco.line.coverage>0.85</jacoco.line.coverage>
    <jacoco.branch.coverage>0.75</jacoco.branch.coverage>
    <!-- See the failsafe systemPropertyVariables block for why this exists. -->
    <docker.api.version>1.44</docker.api.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- AC-6.6: API documentation is generated from the implementation, never hand-maintained. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Enforces the dependency rule from engineering-spec.md §3.3. The domain layer must
      import no framework, because that is what lets the destination policy and code
      generation be tested with no Spring context and no database. A layering rule that
      only exists in a document is a wish; this makes it a build failure.
    -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.4.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Unit tests: fast, no containers. Bound to `test`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Integration tests: real PostgreSQL via Testcontainers. Bound to `verify`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <!--
              docker-java ships api.version=1.32 as its bundled default and reads it as a
              SYSTEM PROPERTY, not from DOCKER_API_VERSION. Docker Engine 29 raised its
              minimum supported API to 1.40, so the bundled default is rejected outright
              and Testcontainers reports "could not find a valid Docker environment" -
              which points at the socket rather than at the real cause.

              Pinned here rather than left to a developer's shell so a clean clone works.
              Override with -Ddocker.api.version=... on an older daemon.
            -->
            <api.version>${docker.api.version}</api.version>
          </systemPropertyVariables>
          <environmentVariables>
            <!--
              Path Testcontainers' cleanup container (Ryuk) uses to reach the daemon from
              INSIDE the container. It is /var/run/docker.sock on every supported runtime,
              including Colima where the host-side socket lives elsewhere. Without it Ryuk
              fails to start on Colima and the failure surfaces as an unrelated
              "can't get Docker image" error.
            -->
            <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        NOTE: jacoco:check skips silently when no execution data exists, so with an empty
        test suite the coverage gate passes vacuously. That is acceptable only while there
        is no production logic to cover. Once T-02 lands, the gate becomes load-bearing and
        a suite that stops producing exec data must be treated as a failure, not a skip.
        Tracked in docs/testing-strategy.md.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>coverage-gate</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
              <excludes>
                <!-- Bootstrap and config carry no branching logic worth asserting. -->
                <exclude>com/smartlink/SmartLinkApplication.class</exclude>
                <exclude>com/smartlink/infrastructure/config/**</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.44.4</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>format-gate</id>
            <phase>validate</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
