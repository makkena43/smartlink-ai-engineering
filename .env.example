# SmartLink — environment template.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Constitution Article VII.1: no real secret is ever placed in a prompt, a fixture,
# or a committed file. Every value below is a placeholder.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=smartlink
POSTGRES_USER=smartlink
POSTGRES_PASSWORD=change-me

SMARTLINK_DB_URL=jdbc:postgresql://postgres:5432/smartlink
SMARTLINK_DB_USER=smartlink
SMARTLINK_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
SMARTLINK_PORT=8080

# Base URL used to construct the short link returned at creation.
# Must match how clients actually reach the service — if this is wrong, every short
# link handed out is wrong, and they are already in the wild by the time you notice.
SMARTLINK_BASE_URL=http://localhost:8080

# Comma-separated API keys accepted for link creation (spec v1, A-08).
# Resolution is anonymous by design; only creation is authenticated.
# Generate real values with: openssl rand -hex 32
SMARTLINK_API_KEYS=replace-with-generated-key

# ---------------------------------------------------------------------------
# Spring profile
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
